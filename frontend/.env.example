# Copia a ".env.local" para desarrollo. En Vercel se define en Settings > Environment Variables.
# IMPORTANTE: debe terminar en /api (es la ruta base del backend).
VITE_API_URL=http://localhost:5000/api

# --- Proyecto de Vercel del panel de administración (subdominio admin) ---
# Solo en ese proyecto. La tienda NO lleva esta variable:
# VITE_APP_MODE=admin
# Dirección de la tienda para el botón "Ver tienda" del panel (opcional: si el panel está en
# admin.tudominio.com se deduce sola). Ej: https://www.xn--malh-tra.com
# VITE_STORE_URL=
