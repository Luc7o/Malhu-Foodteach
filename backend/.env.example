# Copia este archivo a ".env" para correr en tu equipo (el .env NUNCA se sube a GitHub).
# En Railway estas mismas variables se cargan en el panel "Variables" del servicio.

# --- Base de datos ---
# Local con MySQL:
DATABASE_URL=mysql+pymysql://root:tu_password@localhost/malhu_foodtech
# Railway (Postgres): usa la referencia del panel, por ejemplo ${{Postgres.DATABASE_URL}}

# --- Seguridad ---
# Genera una clave larga: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto
# En producción: la URL exacta del frontend (sin "/" al final). Varias, separadas por coma.
# Ejemplo: https://malhu-foodteach.vercel.app
CORS_ORIGINS=*

# --- Pedidos ---
PICKUP_CODE_EXPIRATION_HOURS=24
PENDING_ORDER_TTL_MINUTES=30
PAYMENT_PROVIDER=simulated
TZ_OFFSET_HOURS=-5

# --- Imágenes de productos ---
# En Railway: crea un Volume montado en /data y usa:
# UPLOAD_FOLDER=/data/uploads
# MAX_UPLOAD_MB=5

# Para el pago real con Izipay y los correos de aviso, mira .env.izipay.example

# ---- Copia estas líneas a tu archivo backend/.env y reemplaza los valores ----

# Activa el pago real (para volver al pago de prueba: simulated)
PAYMENT_PROVIDER=izipay

# Claves de API REST del Back Office Vendedor de Izipay (empieza con las de TEST)
IZIPAY_USERNAME=tu_identificador_de_tienda
IZIPAY_PASSWORD=testpassword_xxxxxxxxxxxx
IZIPAY_PUBLIC_KEY=tu_identificador_de_tienda:testpublickey_xxxxxxxxxxxx
IZIPAY_HMAC_KEY=tu_clave_hmac_sha256_de_test

# Opcional: URL pública de la IPN (solo con dominio https). También se puede dejar
# vacía y configurarla en el Back Office.
# IZIPAY_IPN_URL=https://tu-dominio.com/api/izipay/ipn

# ---- Avisos por correo (si MAIL_SERVER queda vacío, no se envían correos) ----
# Ejemplo con Gmail (necesita "contraseña de aplicación"):
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicación
MAIL_FROM=tu_correo@gmail.com

# Quién recibe las alertas de administrador (separados por coma).
# Si lo dejas vacío, se usa el correo de los usuarios con rol admin.
ADMIN_ALERT_EMAILS=tu_correo@gmail.com

# Aviso de "por agotarse" cuando quedan estas unidades o menos
LOW_STOCK_THRESHOLD=3