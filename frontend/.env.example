# Copia a ".env.local" para desarrollo. En Vercel se define en Settings > Environment Variables.
# IMPORTANTE: debe terminar en /api (es la ruta base del backend).
VITE_API_URL=http://localhost:5000/api

# --- Subdominio de administración (Caso A: segundo proyecto en Vercel) ---
# Solo en el proyecto de Vercel del admin:
# VITE_APP_MODE=admin
# Solo en el proyecto de la tienda (opcional, el enlace "Administración" apunta al subdominio):
# VITE_ADMIN_URL=https://admin.xn--malh-tra.com
